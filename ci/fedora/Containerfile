FROM registry.fedoraproject.org/fedora:44

ENV LLVM_VERSION=18

RUN dnf install --assumeyes --quiet gcc just tar git node \
    cargo rust clippy rustfmt \
    llvm$LLVM_VERSION llvm$LLVM_VERSION-devel \
    libstdc++-devel libstdc++-static libffi-devel zlib-devel

RUN dnf clean all && rm -rf /var/log/*
