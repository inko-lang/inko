# Types and methods for dropping values.

# Drops the given value.
#
# This method drops the value simply by taking ownership of it, and dropping it
# before returning. This allows one to drop a value before reaching the end of a
# scope.
fn pub inline drop[T](_value: T) {
  # _value dropped implicitly
}

# A type that defines a destructor to run when the type is dropped.
trait pub Drop {
  # The destructor for this type.
  #
  # This method is called _before_ the memory of `self` is released. It doesn't
  # take ownership of `self` as that would result in the destructor being called
  # multiple times.
  fn mut drop
}

# A type which must be dropped manually.
#
# Use of this type is extremely unsafe as the inner value may be dropped while
# the `ManuallyDrop` container is still in use. As such it's currently also not
# part of the public API.
#
# Note that while this type ensures the inner value isn't dropped, borrow count
# changes may still be generated when accessing the `inner` field. As such it's
# extremely important to be careful to _not_ use this value any more after
# dropping it.
type builtin ManuallyDrop[T] {
  let @inner: T

  fn static new(value: T) -> Self {
    Self(value)
  }
}
