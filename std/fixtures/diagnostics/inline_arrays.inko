fn example1 {
  let a: InlineArray[Int, 4] = inline [1, 2, 3]
}

fn example2 -> InlineArray[Int, 4] {
  inline [1, 2, 3]
}

fn example3 {
  let a: InlineArray[Int, 0] = inline []
}

fn example4 {
  inline [10, 20] == inline [1]
}

fn example5(value: InlineArray[Int, 2]) {
  value.set(0, 'foo')
}

fn example6(value: InlineArray[Int, 2]) {
  match value {
    case [1, 2] -> 10
    case [1, 2, 3] -> 20
    case _ -> 30
  }
}

