type A {
  let @b: B

  fn nil_argument(value: Nil) {}

  fn a_argument(value: A) {}
}

type B {}

fn example1 {
  let mut a = A(B())

  a.nil_argument(a = A(B()))
}

fn example2 {
  let mut a = A(B())

  a.a_argument(a := A(B()))
}

fn example3 {
  let mut a = A(B())

  fn move { a.nil_argument(a = A(B())) }
}

fn example4 {
  let mut a = A(B())

  fn move { a.a_argument(a := A(B())) }
}

