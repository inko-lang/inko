import std.drop (drop)

type Inner {}

type inline Outer {
  let @a: Inner
  let @b: Inner

  fn move submit {
    drop(@a)
    helper
  }

  fn move helper {}
}

type async Main {
  fn async main {
    Outer(a: Inner(), b: Inner()).submit
  }
}

