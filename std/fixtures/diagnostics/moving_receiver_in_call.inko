type User {
  fn move_owned(user: User) {}

  fn move_borrow(user: ref User) {}
}

type A {
  let @b: B

  fn move move_self {
    @b.move_argument(self)
  }
}

type B {
  let @c: C

  fn move_argument(a: A) {}
}

type C {}

fn example1(user: User) {
  user.move_owned(user)
}

fn example2(user: uni User) {
  user.move_owned(user)
}

fn example3(user: ref User) {
  user.move_borrow(user)
}

fn example4(user: mut User) {
  user.move_borrow(user)
}

fn example5(user: User) -> User {
  user.move_owned(return user)
  user
}

fn example6(a: A) {
  a.b.move_argument(a)
}

