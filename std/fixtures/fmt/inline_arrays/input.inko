fn example {
  inline [
    100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000,
  ]

  inline [
    100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000,

    # This is a comment
    100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000,
  ]

  inline [ foo('aaaaaaaaaaaaaaaaaaaaaaaaaa'), foo('bbbbbbbbbbbbbbbbbbbbbbb'), foo('cccccccccccccccccc'), ]

  inline [10 * 2]

  inline [10 * 'foooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooooo']

  inline [10 * [
    100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000,

    # This is a comment
    100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000, 100_000_000,
  ]]
}
