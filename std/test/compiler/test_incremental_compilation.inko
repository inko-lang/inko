import helpers (compiler_path)
import std.env
import std.fs.file (WriteOnlyFile)
import std.fs.path (Path)
import std.sys (Command, Stream)
import std.test (Tests)

fn with[R](
  id: Int,
  body: fn (Path, Path, Path, Path) -> Result[R, String],
) -> Result[R, String] {
  let dir = env.temporary_directory.join('inko-incremental-${id}')
  let _ = try dir.create_directory.map_error(fn (e) { e.to_string })
  let src = dir.join('main.inko')
  let exe = dir.join('build').join('debug').join('main')
  let res = body.call(dir.clone, compiler_path, src, exe)
  let _ = dir.remove_directory_all

  res
}

fn build(
  compiler: ref Path,
  directory: ref Path,
  file: ref Path,
) -> Result[Nil, String] {
  let cmd = Command.new(compiler)

  cmd.stdout = Stream.Null
  cmd.stdin = Stream.Null
  cmd.stderr = Stream.Piped
  cmd.directory = directory.clone
  cmd.arguments = ['build', '--threads=1', file.to_string]

  let child = match cmd.spawn {
    case Ok(v) -> v
    case Error(e) -> throw 'failed to start the compiler: ${e}'
  }

  let status = match child.wait {
    case Ok(v) -> v
    case Error(e) -> throw 'failed to wait for the compiler: ${e}'
  }

  if !status.success? {
    let buf = ByteArray.new
    let Ok(_) = child.stderr.as_mut.get.read_all(buf) else {
      throw 'failed to read STDERR'
    }

    throw buf.into_string
  }

  Result.Ok(nil)
}

fn run(exe: ref Path) -> Result[String, String] {
  let cmd = Command.new(exe)

  cmd.stdin = Stream.Null
  cmd.stdout = Stream.Piped
  cmd.stderr = Stream.Piped

  let child = match cmd.spawn {
    case Ok(v) -> v
    case Error(e) -> throw 'failed to run ${exe}: ${e}'
  }

  let status = match child.wait {
    case Ok(v) -> v
    case Error(e) -> throw 'failed to wait for the executable: ${e}'
  }

  let buf = ByteArray.new

  if status.success? {
    let Ok(_) = child.stdout.as_mut.get.read_all(buf) else {
      throw 'failed to read STDOUT'
    }

    Result.Ok(buf.into_string)
  } else {
    let Ok(_) = child.stderr.as_mut.get.read_all(buf) else {
      throw 'failed to read STDERR'
    }

    Result.Error(buf.into_string)
  }
}

fn write(value: String, to: ref Path) -> Result[Nil, String] {
  WriteOnlyFile.new(to).then(fn (f) { f.write(value) }).map_error(fn (e) {
    'failed to write to ${to}: ${e}'
  })
}

fn pub tests(t: mut Tests) {
  t.ok(
    'A method with explicit type arguments depends on the modules of its type arguments',
    fn (t) {
      with(t.id, fn (dir, inko, src, exe) {
        try write(
          '
import std.reflect (size_of)
import std.stdio (Stdout)

type inline A {
  let @a: Int
}

type async Main {
  fn async main {
    Stdout.new.write(size_of[A].to_string)
  }
}
        ',
          to: src,
        )

        let _ = try build(inko, dir, src)
        let res1 = run(exe)

        try write(
          '
import std.reflect (size_of)
import std.stdio (Stdout)

type inline A {
  let @a: Int
  let @b: Int
}

type async Main {
  fn async main {
    Stdout.new.write(size_of[A].to_string)
  }
}
        ',
          to: src,
        )

        let _ = try build(inko, dir, src)
        let res2 = run(exe)

        t.equal(res1, Result.Ok('8'))
        t.equal(res2, Result.Ok('16'))

        Result.Ok(nil)
      })
    },
  )

  t.ok(
    'The storage semantics of a type are taken into account for incremental caches',
    fn (t) {
      with(t.id, fn (dir, inko, src, exe) {
        try write(
          '
import std.reflect (size_of)
import std.stdio (Stdout)

type inline Person {
  let mut @name: String
  let @age: Int
}

type Box {
  let @person: Person
}

type async Main {
  fn async main {
    let _tup = (10, Person(name: "Alice", age: 42))

    Stdout.new.write(size_of[(Int, Person)].to_string)
  }
}
        ',
          to: src,
        )

        let _ = try build(inko, dir, src)
        let res1 = run(exe)

        try write(
          '
import std.reflect (size_of)
import std.stdio (Stdout)

type Person {
  let mut @name: String
  let @age: Int
}

type Box {
  let @person: Person
}

type async Main {
  fn async main {
    let _tup = (10, Person(name: "Alice", age: 42))

    Stdout.new.write(size_of[(Int, Person)].to_string)
  }
}
        ',
          to: src,
        )

        let _ = try build(inko, dir, src)
        let res2 = run(exe)

        t.equal(res1, Result.Ok('24'))
        t.equal(res2, Result.Ok('16'))

        Result.Ok(nil)
      })
    },
  )
}
