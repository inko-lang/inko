FROM registry.fedoraproject.org/fedora-minimal:latest AS builder

RUN dnf install --no-docs --assumeyes --setopt=install_weak_deps=False \
    gcc make rust cargo llvm llvm-devel llvm-static \
    libstdc++-devel libstdc++-static libffi-devel zlib-devel libxml2-devel
ADD . /inko/
WORKDIR /inko
RUN make build PREFIX='/usr'
RUN strip target/release/inko
RUN make install PREFIX='/usr'

FROM registry.fedoraproject.org/fedora-minimal:latest

# gcc is needed to link object files. This also pulls in libgcc, which the
# generated code links against dynamically.
#
# We also install tar, Git and Node such that GitHub Actions jobs can use this
# image without having to install these packages themselves.
RUN dnf install --no-docs --assumeyes --setopt=install_weak_deps=False \
    gcc tar git nodejs

RUN dnf clean all && rm -rf /var/log/*

COPY --from=builder ["/usr/bin/inko", "/usr/bin/inko"]
COPY --from=builder ["/usr/lib/inko", "/usr/lib/inko/"]
COPY --from=builder ["/usr/share/licenses/inko", "/usr/share/licenses/inko/"]
